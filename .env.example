PORT=3000
API_V1_PREFIX=/api/v1
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
REQUEST_BODY_LIMIT=50mb
SWAGGER_TITLE=Food Route Express API
SWAGGER_DESCRIPTION=Food Route backend API.

APP_FIREBASE_PROJECT_ID=demo-food-route
APP_FIREBASE_USE_EMULATORS=false
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
APP_FIREBASE_WEB_API_KEY=demo-api-key
APP_FIREBASE_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
APP_FIREBASE_SERVICE_ACCOUNT_JSON=

AUTH_VERIFICATION_MODE=otp
AUTH_PASSWORD_RESET_MODE=otp
OTP_SIGNING_SECRET=change-me
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
EMAIL_DELIVERY_MODE=log
PUSH_NOTIFICATION_PROVIDER=firebase
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ONESIGNAL_API_URL=https://api.onesignal.com/notifications

PUSH_NOTIFICATION_PROVIDER=onesignal
ONESIGNAL_APP_ID=...
ONESIGNAL_REST_API_KEY=...
ONESIGNAL_API_URL=https://api.onesignal.com/notifications

INITIAL_SUPER_ADMIN_FULLNAME=Super Admin
INITIAL_SUPER_ADMIN_PHONE=+8801700000000
INITIAL_SUPER_ADMIN_EMAIL=admin@example.com
INITIAL_SUPER_ADMIN_PASSWORD=Password123
